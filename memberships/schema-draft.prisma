// peakst8 Club Memberships: schema draft
// Merge into peakst8-backend/prisma/schema.prisma. Conventions follow that file:
// uuid ids, snake_case @@map, updatedAt/createdAt on every model, soft delete via isDeleted/isArchived,
// money as Float (as Category.baseAmount does today).

enum PLAN_KIND {
  MEMBERSHIP // recurring or prepaid access with a per-period limit
  PACK // fixed number of credits with an expiry
}

enum PLAN_BILLING_TYPE {
  RECURRING
  ONE_TIME
}

enum PLAN_INTERVAL {
  WEEKLY
  MONTHLY
  EVERY_4_WEEKS
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PLAN_VALIDITY {
  NEVER_EXPIRES
  FROM_PURCHASE // validityDays after purchase
  FROM_FIRST_USE // validityDays after first booking
  FIXED_DATE // validUntil
}

enum PLAN_LIMIT_PERIOD {
  UNLIMITED
  TOTAL // packs: usageLimit for the life of the plan
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_YEAR
}

enum PLAN_CANCELLATION_POLICY {
  AUTO // member cancels directly
  REVIEW // member sends a request, host approves
}

enum PLAN_PRICE_POLICY {
  FREE
  HALF
  FULL
  CUSTOM_PERCENT // customValue = percent off
  CUSTOM_FLAT // customValue = rupees off
}

enum USER_PLAN_STATUS {
  PENDING_APPROVAL
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELS_AT_PERIOD_END
  ENDED
  ABANDONED
}

enum USER_PLAN_SOURCE {
  PURCHASE
  SENT_BY_HOST
  SWITCHED
}

enum PLAN_USAGE_STATUS {
  HELD // order open
  CONSUMED // ticket generated
  RELEASED // order failed or expired, or cancelled inside the window
}

enum PLAN_CHARGE_TYPE {
  FIRST_PAYMENT
  RENEWAL
  JOINING_FEE
  FIX_BILLING
  SWITCH
  BILLING_DATE_CHANGE
}

enum PLAN_SHARE_STATUS {
  INVITED
  ACTIVE
  REVOKED
}

enum GUEST_PASS_STATUS {
  SENT
  CLAIMED
  REDEEMED
  EXPIRED
}

enum GUEST_ELIGIBILITY {
  FIRST_TIME_ONLY
  ANYONE
}

enum COUPON_APPLIES_TO {
  FIRST_CHARGE // default, as SweatPals does
  EVERY_CHARGE // e.g. a student rate
  FIRST_N_CHARGES
}

enum PERK_CATEGORY {
  GEAR
  NUTRITION
  FOOD_AND_DRINK
  RECOVERY
  WEARABLES
  OTHER
}

enum PERK_VISIBILITY {
  TEASER // everyone sees the brand and offer; code only for unlocking plans
  MEMBERS_ONLY // hidden from people without an unlocking plan
}

enum PLAN_REMINDER_TYPE {
  PRE_DEBIT // launch prerequisite: >= 24 h before every recurring charge (RBI e-mandate)
  CHARGED // launch prerequisite: post-debit receipt
  PAYMENT_FAILED // launch prerequisite: with fix-billing link, on each retry
  MANDATE_AT_RISK // launch prerequisite: mandate cancelled/expired or card expiring before the charge
  INTRO_ENDING // launch prerequisite: first full-price charge is coming
  PACK_EXPIRING
  ACCESS_ENDING
  LOW_CREDITS
  PAUSE_ENDING
}

enum PLAN_REMINDER_STATUS {
  SCHEDULED
  SENT
  FAILED
  CANCELLED // superseded by a pause, date change, cancel or price change
}

model Plan {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId                  String                   @db.Uuid
  club                    Club                     @relation(fields: [clubId], references: [id])
  kind                    PLAN_KIND
  name                    String
  description             String
  coverImage              String?
  // Usage limit
  limitPeriod             PLAN_LIMIT_PERIOD        @default(UNLIMITED)
  usageLimit              Int? // null when UNLIMITED
  rollOverUnused          Boolean                  @default(false)
  // Rules
  isApprovalRequired      Boolean                  @default(false)
  isFirstTimeOnly         Boolean                  @default(false)
  isOnePerMember          Boolean                  @default(false)
  capacity                Int? // max active holders
  isUnlisted              Boolean                  @default(false)
  isFeatured              Boolean                  @default(false)
  isShareable             Boolean                  @default(false)
  shareSeats              Int? // seats besides the holder
  guestPassesPerCycle     Int? // null = guest passes off
  guestEligibility        GUEST_ELIGIBILITY        @default(FIRST_TIME_ONLY)
  // Perks (club admins choose per plan)
  earlyAccessHours        Int? // holders book this many hours before Event.publicOpensAt
  waitlistPriority        Boolean                  @default(false)
  allowDiscountCodes      Boolean                  @default(false) // club admin turns discount codes on per plan
  couponLinks             CouponToPlan[]
  perks                   PlanPerk[]
  cancellationPolicy      PLAN_CANCELLATION_POLICY @default(AUTO)
  minCommitmentCycles     Int? // recurring only
  whatsappGroupInviteUrl  String?
  waiver                  Waiver?                  @relation(fields: [waiverId], references: [id])
  waiverId                Int?
  customForm              Json? // questionnaire, same shape as Event.customWaiverForm
  isPublished             Boolean                  @default(false)
  isArchived              Boolean                  @default(false) // discontinued: holders keep it, no new joins
  order                   Int?
  prices                  PlanPrice[]
  coverage                PlanCoverage[]
  categoryPolicies        CategoryPlanPolicy[]
  userPlans               UserPlan[]
  joinRequests            PlanJoinRequest[]
  updatedAt               DateTime                 @updatedAt
  createdAt               DateTime                 @default(now())

  @@index([clubId, isPublished, isArchived])
  @@map("plan")
}

/// A price option on a plan (SweatPals "tier").
model PlanPrice {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId           String            @db.Uuid
  plan             Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  label            String? // "Monthly", "Annual"
  amount           Float
  isAmountInclusiveGST Boolean       @default(false)
  billingType      PLAN_BILLING_TYPE
  interval         PLAN_INTERVAL? // RECURRING only
  validity         PLAN_VALIDITY? // ONE_TIME only
  validityDays     Int?
  validUntil       DateTime?
  joiningFee       Float?
  razorpayPlanId   String?           @unique // created lazily for RECURRING
  isActive         Boolean           @default(true)
  introOffers      PlanIntroOffer[]
  userPlans        UserPlan[]
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())

  @@map("plan_price")
}

/// Discounted first period, redeemable once per member per plan.
model PlanIntroOffer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planPriceId    String        @db.Uuid
  planPrice      PlanPrice     @relation(fields: [planPriceId], references: [id], onDelete: Cascade)
  amount         Float // total charged for the intro period
  durationDays   Int
  isActive       Boolean       @default(true)
  userPlans      UserPlan[]
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())

  @@map("plan_intro_offer")
}

/// What the plan covers: an event type for the club, or one explicit event. One of the two is set.
model PlanCoverage {
  id         Int         @id @default(autoincrement())
  planId     String      @db.Uuid
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  eventType  EVENT_TYPE?
  eventId    String?
  event      Event?      @relation(fields: [eventId], references: [id])
  updatedAt  DateTime    @updatedAt
  createdAt  DateTime    @default(now())

  @@unique([planId, eventType])
  @@unique([planId, eventId])
  @@map("plan_coverage")
}

/// What a plan holder pays for a ticket category. No row = no benefit (full price).
model CategoryPlanPolicy {
  categoryId   String            @db.Uuid
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  planId       String            @db.Uuid
  plan         Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  policy       PLAN_PRICE_POLICY
  customValue  Float?
  updatedAt    DateTime          @updatedAt
  createdAt    DateTime          @default(now())

  @@id([categoryId, planId])
  @@map("category_plan_policy")
}

/// A member's copy of a plan (SweatPals "user-to-membership").
model UserPlan {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  user                   User               @relation(fields: [userId], references: [id])
  planId                 String             @db.Uuid
  plan                   Plan               @relation(fields: [planId], references: [id])
  planPriceId            String             @db.Uuid
  planPrice              PlanPrice          @relation(fields: [planPriceId], references: [id])
  introOfferId           String?            @db.Uuid
  introOffer             PlanIntroOffer?    @relation(fields: [introOfferId], references: [id])
  status                 USER_PLAN_STATUS   @default(PENDING_PAYMENT)
  source                 USER_PLAN_SOURCE   @default(PURCHASE)
  priceOverride          Float? // host "change price" for all future cycles
  startedAt              DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime? // renewal date (recurring) or expiry (one-time)
  creditsOverride        Int? // host "change credits" for the current period
  firstUsedAt            DateTime? // drives FROM_FIRST_USE validity
  pausedAt               DateTime?
  pauseUntil             DateTime? // null = indefinite
  cancelRequestedAt      DateTime?
  cancelAt               DateTime? // CANCELS_AT_PERIOD_END → ENDED at this time
  endedAt                DateTime?
  commitmentEndsAt       DateTime?
  razorpaySubscriptionId String?            @unique
  claimToken             String?            @unique // Send plan link
  couponId               String?            @db.Uuid // discount carried into renewals when it applies to every charge
  usages                 PlanUsage[]
  charges                PlanCharge[]
  shares                 PlanShare[]
  guestPasses            GuestPass[]
  cancelRequests         PlanCancelRequest[]
  history                UserPlanEvent[]
  reminders              PlanReminderDelivery[]
  registrations          Registration[]
  updatedAt              DateTime           @updatedAt
  createdAt              DateTime           @default(now())

  @@index([userId, status])
  @@index([planId, status])
  @@index([status, currentPeriodEnd]) // renewal and expiry sweeps
  @@map("user_plan")
}

/// One row per booking that used a plan. This is the usage meter.
model PlanUsage {
  id               String            @id @default(uuid()) @db.Uuid
  userPlanId       String            @db.Uuid
  userPlan         UserPlan          @relation(fields: [userPlanId], references: [id])
  registrationId   String            @unique @db.Uuid
  registration     Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  usedByUserId     String            @db.Uuid // holder or a share member
  eventDate        DateTime // limits are counted by event date
  status           PLAN_USAGE_STATUS @default(HELD)
  amountSaved      Float
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())

  @@index([userPlanId, status, eventDate])
  @@map("plan_usage")
}

model PlanCharge {
  id                String           @id @default(uuid()) @db.Uuid
  userPlanId        String           @db.Uuid
  userPlan          UserPlan         @relation(fields: [userPlanId], references: [id])
  type              PLAN_CHARGE_TYPE
  amount            Float
  periodStart       DateTime?
  periodEnd         DateTime?
  razorpayOrderId   String?          @unique
  razorpayPaymentId String?          @unique
  razorpayInvoiceId String?
  status            ORDER_STATUS     @default(INITIATED)
  attempt           Int              @default(1)
  refundedAmount    Float            @default(0)
  updatedAt         DateTime         @updatedAt
  createdAt         DateTime         @default(now())

  @@index([userPlanId, createdAt])
  @@map("plan_charge")
}

model PlanJoinRequest {
  id                     String          @id @default(uuid()) @db.Uuid
  planId                 String          @db.Uuid
  plan                   Plan            @relation(fields: [planId], references: [id])
  userId                 String          @db.Uuid
  user                   User            @relation(fields: [userId], references: [id])
  planPriceId            String          @db.Uuid
  status                 APPROVAL_STATUS @default(PENDING)
  isWithdrawn            Boolean         @default(false)
  reviewedById           String?         @db.Uuid
  reviewedBy             Host?           @relation(fields: [reviewedById], references: [userId])
  updatedAt              DateTime        @updatedAt
  createdAt              DateTime        @default(now())

  @@index([planId, status])
  @@map("plan_join_request")
}

model PlanCancelRequest {
  id           String          @id @default(uuid()) @db.Uuid
  userPlanId   String          @db.Uuid
  userPlan     UserPlan        @relation(fields: [userPlanId], references: [id])
  reason       String?
  status       APPROVAL_STATUS @default(PENDING)
  reviewedById String?         @db.Uuid
  reviewedBy   Host?           @relation(fields: [reviewedById], references: [userId])
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  @@map("plan_cancel_request")
}

model PlanShare {
  id            String            @id @default(uuid()) @db.Uuid
  userPlanId    String            @db.Uuid
  userPlan      UserPlan          @relation(fields: [userPlanId], references: [id])
  invitedEmail  String?
  invitedPhone  String?
  memberUserId  String?           @db.Uuid // set on claim
  memberUser    User?             @relation("PlanShareMember", fields: [memberUserId], references: [id])
  status        PLAN_SHARE_STATUS @default(INVITED)
  claimToken    String            @unique
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  @@map("plan_share")
}

model GuestPass {
  id              String            @id @default(uuid()) @db.Uuid
  userPlanId      String            @db.Uuid
  userPlan        UserPlan          @relation(fields: [userPlanId], references: [id])
  guestUserId     String?           @db.Uuid
  guestUser       User?             @relation("GuestPassGuest", fields: [guestUserId], references: [id])
  registrationId  String?           @unique @db.Uuid
  status          GUEST_PASS_STATUS @default(SENT)
  claimToken      String            @unique
  periodStart     DateTime // counts against guestPassesPerCycle for this period
  expiresAt       DateTime?
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())

  @@map("guest_pass")
}

/// Append-only history for member and host actions.
model UserPlanEvent {
  id          Int      @id @default(autoincrement())
  userPlanId  String   @db.Uuid
  userPlan    UserPlan @relation(fields: [userPlanId], references: [id])
  type        String // JOINED, RENEWED, RENEWAL_FAILED, PAUSED, RESUMED, CANCEL_REQUESTED, CANCELLED, ENDED, PRICE_CHANGED, CREDITS_CHANGED, BILLING_DATE_CHANGED, SWITCHED, REFUNDED, SHARED, ...
  actorUserId String?  @db.Uuid
  data        Json?
  createdAt   DateTime @default(now())

  @@index([userPlanId, createdAt])
  @@map("user_plan_event")
}


/// Club admins' membership settings. One row per club; every plan inherits it.
model ClubMembershipSettings {
  clubId               String                 @id @db.Uuid
  club                 Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isEnabled            Boolean                @default(false) // switched on by peakst8 admin
  plansVisibleTo       String                 @default("EVERYONE") // EVERYONE | CLUB_MEMBERS
  reminderOffsetsHours Int[]                  @default([72, 24]) // 24 is always kept
  yearlyReminderHours  Int[]                  @default([168, 24])
  reminderChannels     NOTIFICATION_CHANNEL[] @default([EMAIL])
  pushEnabled          Boolean                @default(true)
  reminderSendHour     Int                    @default(9) // IST, never 21:00–08:00
  optionalReminders    PLAN_REMINDER_TYPE[]   @default([PACK_EXPIRING, ACCESS_ENDING])
  creditReleaseHours   Int                    @default(12)
  lateCancelUsesCredit Boolean                @default(true)
  failedPaymentGraceDays Int                  @default(0)
  refundPolicyText     String?
  seePlansBannerText   String?
  updatedAt            DateTime               @updatedAt
  createdAt            DateTime               @default(now())

  @@map("club_membership_settings")
}

/// One row per reminder per charge per channel. Scheduled by a BullMQ job scheduler sweep;
/// recomputed (old rows CANCELLED) when a plan is paused, resumed, re-dated, re-priced or cancelled.
model PlanReminderDelivery {
  id           String               @id @default(uuid()) @db.Uuid
  userPlanId   String               @db.Uuid
  userPlan     UserPlan             @relation(fields: [userPlanId], references: [id], onDelete: Cascade)
  type         PLAN_REMINDER_TYPE
  channel      String // EMAIL | WHATSAPP | PUSH
  dueAt        DateTime // the charge, expiry or end this reminder is about
  scheduledFor DateTime
  status       PLAN_REMINDER_STATUS @default(SCHEDULED)
  amount       Float?
  sentAt       DateTime?
  attemptCount Int                  @default(0)
  errorMessage String?
  updatedAt    DateTime             @updatedAt
  createdAt    DateTime             @default(now())

  @@unique([userPlanId, type, channel, dueAt])
  @@index([status, scheduledFor])
  @@map("plan_reminder_delivery")
}

/// A partner perk a club offers its plan holders (e.g. 15% off at a running store).
model ClubPerk {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId      String     @db.Uuid
  club        Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  partnerName String
  category    PERK_CATEGORY   @default(OTHER)
  visibility  PERK_VISIBILITY @default(TEASER)
  offer       String // "15% off shoes"
  redeemHow   String? // "Show your plan at the counter"
  code        String? // shown only to holders
  logo        String?
  isActive    Boolean    @default(true)
  revealCount Int        @default(0) // "Reveal code" taps, reported back to the brand
  order       Int?
  plans       PlanPerk[]
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  @@map("club_perk")
}

/// Which plans unlock which partner perks.
model PlanPerk {
  planId    String   @db.Uuid
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  perkId    String   @db.Uuid
  perk      ClubPerk @relation(fields: [perkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([planId, perkId])
  @@map("plan_perk")
}

/// Which plans a club discount code applies to (reuses the existing Coupon).
model CouponToPlan {
  couponId     String            @db.Uuid
  coupon       Coupon            @relation(fields: [couponId], references: [id], onDelete: Cascade)
  planId       String            @db.Uuid
  plan         Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  appliesTo    COUPON_APPLIES_TO @default(FIRST_CHARGE)
  chargesCount Int? // for FIRST_N_CHARGES
  createdAt    DateTime          @default(now())

  @@id([couponId, planId])
  @@map("coupon_plan")
}

